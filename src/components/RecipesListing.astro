---
import RecipeCard from './RecipeCard.astro';

interface Recipe {
  id: string;
  data: {
    title: string;
    description: string;
    course: string;
    calories: number;
    totalTime: number;
    tags?: string[];
    image?: string;
    featured?: boolean;
    ingredients?: { name: string }[];
  };
}

interface Props {
  recipes: Recipe[];
  activeCourse?: string;
}

const { recipes, activeCourse = '' } = Astro.props;

const courses = ['breakfast', 'lunch', 'dinner', 'snack'];
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const searchText = (r: Recipe) =>
  [r.data.title, r.data.description, r.data.course, ...(r.data.tags ?? []), ...(r.data.ingredients ?? []).map(i => i.name)]
    .join(' ').replace(/-/g, ' ').toLowerCase();
---

<div class="recipes-page">
  <header class="page-header">
    <div class="page-header-inner">
      <span class="section-label" style="color: var(--nd-terra-light);">Free recipes</span>
      {activeCourse
        ? <h1 class="page-title">{cap(activeCourse)}<br><em>recipes.</em></h1>
        : <h1 class="page-title">Eat well.<br><em>Every day.</em></h1>}
      <p class="page-desc">
        {activeCourse
          ? `${cap(activeCourse)} recipes — calorie-counted, nutritionist-crafted, and rooted in Eastern European tradition.`
          : 'Every recipe is calorie-counted, nutritionist-crafted, and rooted in Eastern European tradition.'}
      </p>
      <nav class="filter-row" aria-label="Filter recipes by course">
        <a href="/recipes/" class:list={['filter-btn', { active: !activeCourse }]}>All</a>
        {courses.map(c => (
          <a
            href={`/recipes/course/${c}/`}
            class:list={['filter-btn', { active: activeCourse === c }]}
            aria-current={activeCourse === c ? 'page' : undefined}
          >{cap(c)}</a>
        ))}
      </nav>
    </div>
  </header>

  <div class="recipes-content">
    {recipes.length > 0 ? (
      <>
      <div class="recipe-search" role="search">
        <label for="recipe-q" class="sr-only">Search recipes</label>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input id="recipe-q" type="search" placeholder="Search recipes or ingredients: buckwheat, beetroot, kefir…" autocomplete="off" />
        <span class="recipe-search-count" id="recipe-count" aria-live="polite"></span>
      </div>
      <p class="recipe-search-empty" id="recipe-empty" hidden>No recipes match that search. Try a single ingredient.</p>
      <div class="recipes-grid">
        {recipes.map(r => (
          <RecipeCard
            title={r.data.title}
            slug={r.id}
            description={r.data.description}
            course={r.data.course}
            calories={r.data.calories}
            totalTime={r.data.totalTime}
            tags={r.data.tags}
            image={r.data.image}
            featured={r.data.featured}
            search={searchText(r)}
          />
        ))}
      </div>
      </>
    ) : (
      <div class="empty-state">
        <div class="empty-emoji">🥗</div>
        <h2>Recipes coming soon</h2>
        <p>We're adding recipes weekly. Subscribe below to get the first ones in your inbox.</p>
        <a href="/#newsletter" class="btn-primary">Get notified →</a>
      </div>
    )}
  </div>
</div>

<script>
  const q = document.getElementById('recipe-q') as HTMLInputElement | null;
  if (q) {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.recipes-grid [data-search]'));
    const count = document.getElementById('recipe-count')!;
    const empty = document.getElementById('recipe-empty')!;
    const apply = () => {
      const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const c of cards) {
        const hit = terms.every(t => c.dataset.search!.includes(t));
        c.style.display = hit ? '' : 'none';
        if (hit) shown++;
      }
      count.textContent = terms.length ? `${shown} of ${cards.length}` : '';
      empty.hidden = shown > 0;
      const url = new URL(location.href);
      if (terms.length) url.searchParams.set('q', q.value.trim()); else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    };
    q.value = new URLSearchParams(location.search).get('q') ?? '';
    q.addEventListener('input', apply);
    if (q.value) apply();
  }
</script>

<style>
  .recipe-search {
    display: flex; align-items: center; gap: 10px;
    max-width: 640px;
    background: var(--nd-warm-white); border: 1px solid var(--nd-border); border-radius: 14px;
    padding: 0 16px; margin-bottom: 32px; color: var(--nd-muted);
    transition: border-color 0.2s;
  }
  .recipe-search:focus-within { border-color: var(--nd-terra); color: var(--nd-terra); }
  .recipe-search input {
    flex: 1; min-width: 0; border: none; outline: none; background: none;
    padding: 14px 0; font-family: inherit; font-size: 16px; color: var(--nd-text);
  }
  .recipe-search-count { font-size: 13px; color: var(--nd-muted); white-space: nowrap; }
  .recipe-search-empty { font-size: 16px; color: var(--nd-muted); margin-bottom: 24px; }
  .recipe-search-empty[hidden] { display: none; }

  .page-header {
    background: var(--nd-forest) url('/images/hero-recipes.webp') center/cover no-repeat;
    padding: 72px 48px 80px;
    position: relative; overflow: hidden;
  }
  .page-header::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to right, rgba(20,35,25,0.82) 50%, rgba(20,35,25,0.55) 100%);
    pointer-events: none;
  }
  .page-header-inner { max-width: var(--max-w); margin: 0 auto; position: relative; z-index: 1; }
  .page-title {
    font-family: var(--font-serif); font-size: clamp(40px, 5vw, 64px);
    font-weight: 900; color: #fff; line-height: 1.08;
    letter-spacing: normal; margin-bottom: 20px;
  }
  .page-title em { font-style: italic; color: var(--nd-terra-light); }
  .page-desc { font-size: 17px; font-weight: 300; color: rgba(255,255,255,0.6); max-width: 480px; line-height: 1.7; margin-bottom: 36px; }
  .filter-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .filter-btn {
    padding: 8px 20px; border-radius: 100px;
    font-size: 13px; font-weight: 600;
    color: rgba(255,255,255,0.55); text-decoration: none;
    border: 1px solid rgba(255,255,255,0.15);
    transition: all 0.2s;
  }
  .filter-btn:hover, .filter-btn.active {
    background: var(--nd-terra); color: #fff; border-color: var(--nd-terra);
  }

  .recipes-content { max-width: var(--max-w); margin: 0 auto; padding: 64px 48px 100px; }
  .recipes-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

  .empty-state { text-align: center; padding: 80px 24px; }
  .empty-emoji { font-size: 72px; margin-bottom: 24px; }
  .empty-state h2 { font-family: var(--font-serif); font-size: 28px; color: var(--nd-forest); margin-bottom: 14px; }
  .empty-state p { font-size: 16px; color: var(--nd-muted); max-width: 400px; margin: 0 auto 28px; line-height: 1.7; }

  @media (max-width: 900px) {
    .page-header { padding: 48px 20px 60px; }
    .recipes-content { padding: 40px 20px 72px; }
    .recipes-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
  @media (max-width: 540px) {
    .recipes-grid { grid-template-columns: 1fr; }
  }
</style>
