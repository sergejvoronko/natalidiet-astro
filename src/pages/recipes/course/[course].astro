---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RecipesListing from '../../../components/RecipesListing.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const courses = ['breakfast', 'lunch', 'dinner', 'snack'];
  const all = await getCollection('recipes');
  all.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

  return courses.map(course => ({
    params: { course },
    props: { recipes: all.filter(r => r.data.course === course), course },
  }));
}

const { recipes, course } = Astro.props;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<BaseLayout
  title={`${cap(course)} Recipes`}
  description={`Healthy Eastern European ${course} recipes — calorie-counted, nutritionist-crafted, and genuinely delicious.`}
  canonical={`https://natalidiet.eu/recipes/course/${course}`}
>
  <RecipesListing recipes={recipes} activeCourse={course} />
</BaseLayout>
